#!/usr/bin/env python3
"""vm/vncshot SOCKET OUT.png   Screenshot of a test VM through its VNC unix socket (works for text consoles and
GL sessions alike; QEMU's own screendump cannot see a virtio-gpu GL scanout). Minimal RFB client: raw encoding."""
import socket, struct, sys, zlib
def png(path, w, h, rgb):
    def chunk(t, d): return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d))
    raw = b"".join(b"\x00" + rgb[y * w * 3:(y + 1) * w * 3] for y in range(h))
    open(path, "wb").write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))
s = socket.socket(socket.AF_UNIX); s.settimeout(15); s.connect(sys.argv[1])
def rd(n):
    b = b""
    while len(b) < n:
        c = s.recv(n - len(b))
        if not c: raise SystemExit("VNC connection closed")
        b += c
    return b
rd(12); s.sendall(b"RFB 003.008\n")
types = rd(rd(1)[0]); assert 1 in types, "VNC server wants authentication"
s.sendall(b"\x01"); assert struct.unpack(">I", rd(4))[0] == 0
s.sendall(b"\x01")                                   # shared session: do not disconnect a viewer
w, h = struct.unpack(">HH", rd(4)); rd(16); rd(struct.unpack(">I", rd(4))[0])
# 32 bpp, depth 24, little endian, true colour, shifts r16 g8 b0
s.sendall(struct.pack(">BxxxBBBBHHHBBBxxx", 0, 32, 24, 0, 1, 255, 255, 255, 16, 8, 0))
s.sendall(struct.pack(">BxHi", 2, 1, 0))             # encodings: raw only
s.sendall(struct.pack(">BBHHHH", 3, 0, 0, 0, w, h))  # full, non-incremental update
fb = bytearray(w * h * 4); got = 0
while got < w * h:
    t = rd(1)[0]
    if t == 0:
        rd(1); n = struct.unpack(">H", rd(2))[0]
        for _ in range(n):
            x, y, rw, rh, enc = struct.unpack(">HHHHi", rd(12))
            if enc != 0: raise SystemExit(f"unexpected encoding {enc}")
            data = rd(rw * rh * 4)
            for row in range(rh):
                o = ((y + row) * w + x) * 4; fb[o:o + rw * 4] = data[row * rw * 4:(row + 1) * rw * 4]
            got += rw * rh
    elif t == 2: pass
    elif t == 3: rd(3); rd(struct.unpack(">I", rd(4))[0])
    elif t == 1: rd(1); rd(2); rd(struct.unpack(">H", rd(2))[0] * 6)
rgb = bytearray(w * h * 3); rgb[0::3] = fb[2::4]; rgb[1::3] = fb[1::4]; rgb[2::3] = fb[0::4]
png(sys.argv[2], w, h, bytes(rgb))
