#!/bin/sh
# vm/vm up [NAME] | ssh [NAME] [CMD...] | push [NAME] SRC DST | shot [NAME] FILE.png | key [NAME] KEYS... | down [NAME] | destroy [NAME] | list
# Throwaway Debian 13 test machines for kaiseki: every test starts from the pristine cloud image, so a
# result never depends on leftovers. KVM, UEFI, 6 CPUs, 8 GB, 100 GB disk (copy-on-write over the base),
# virtio-gpu with OpenGL rendered off-screen on the host GPU (Hyprland needs GL; no window is opened),
# ssh on a local port. User "kaiseki" (password "kaiseki", passwordless sudo, project ssh key).
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd); C=$ROOT/.cache; V=$C/vm
# KAISEKI_BASE=forky starts new machines from Debian testing instead of Debian 13
case "${KAISEKI_BASE:-trixie}" in forky) BASE=$C/debian-14-generic-amd64-daily.qcow2 ;; *) BASE=$C/debian-13-generic-amd64.qcow2 ;; esac
cmd=${1:-}; [ $# -gt 0 ] && shift
name=${1:-test}; case "$cmd" in list) ;; *) [ $# -gt 0 ] && shift || true ;; esac
case "$name" in -*|up|metal|ssh|push|shot|key|type|view|down|destroy|list) echo "\"$name\" is not a machine name (usage: vm COMMAND NAME ...)" >&2; exit 2 ;; esac
D=$V/$name; KEY=$C/id_ed25519
port() { cat "$D/port"; }
U=${KAISEKI_VM_USER:-kaiseki}   # the login on machines the installer made is the owner you chose
SSH() { ssh -q -i "$KEY" -p "$(port)" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 -o LogLevel=ERROR "$U@127.0.0.1" "$@"; }
qmp() { python3 - "$D/qmp" "$@" <<'PY'
import json, socket, sys
s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); f = s.makefile("rw")
def cmd(c, **a):
    f.write(json.dumps({"execute": c, "arguments": a}) + "\n"); f.flush()
    while True:
        r = json.loads(f.readline())
        if "return" in r or "error" in r: return r
f.readline(); cmd("qmp_capabilities")
if sys.argv[2] == "shot": print(cmd("screendump", filename=sys.argv[3], format="png"))
elif sys.argv[2] == "quit": cmd("quit")
elif sys.argv[2] == "type":  # a line of US-layout text, then Enter
    import time
    names = {" ": "spc", "-": "minus", "=": "equal", "/": "slash", ".": "dot", ",": "comma", ";": "semicolon", "'": "apostrophe",
             "[": "bracket_left", "]": "bracket_right", "\\": "backslash", "`": "grave_accent"}
    shifted = dict(zip('!@#$%^&*()_+?><:"{}|~', "1234567890-=/.,;'[]\\`"))
    for ch in " ".join(sys.argv[3:]):
        shift = ch.isupper() or ch in shifted; ch = shifted.get(ch, ch.lower())
        keys = (["shift"] if shift else []) + [names.get(ch, ch)]
        cmd("send-key", keys=[{"type": "qcode", "data": k} for k in keys]); time.sleep(0.03)
    cmd("send-key", keys=[{"type": "qcode", "data": "ret"}])
elif sys.argv[2] == "key":
    import time
    for combo in sys.argv[3:]:
        env = __import__("os").environ   # KAISEKI_KEY_HOLD (ms) and KAISEKI_KEY_DELAY (s): for long runs of one key
        cmd("send-key", keys=[{"type": "qcode", "data": k} for k in combo.split("+")], **({"hold-time": int(env["KAISEKI_KEY_HOLD"])} if "KAISEKI_KEY_HOLD" in env else {}))
        time.sleep(float(env.get("KAISEKI_KEY_DELAY", "0.15")))
PY
}
case "$cmd" in
up)
    # a machine the installer made (vm metal, installer/try) has no cloud seed: start it the way it was made
    if [ -f "$D/disk.qcow2" ] && [ ! -f "$D/seed.iso" ]; then exec "$0" metal "$name"; fi
    [ -f "$BASE" ] || { echo "base image missing: $BASE" >&2; exit 1; }
    [ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N '' -C kaiseki-vm -f "$KEY"
    if [ -f "$D/pid" ] && kill -0 "$(cat "$D/pid")" 2>/dev/null; then echo "$name is already running (ssh port $(port))"; exit 0; fi
    mkdir -p "$D"
    if [ ! -f "$D/disk.qcow2" ]; then
        qemu-img create -q -f qcow2 -b "$BASE" -F qcow2 "$D/disk.qcow2" 100G
        cp /usr/share/OVMF/OVMF_VARS_4M.fd "$D/vars.fd"
        cat > "$D/user-data" <<UD
#cloud-config
hostname: kaiseki-$name
users:
  - name: kaiseki
    gecos: kaiseki test user
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: kaiseki
    ssh_authorized_keys: [ "$(cat "$KEY.pub")" ]
ssh_pwauth: false
UD
        printf 'instance-id: kaiseki-%s-%s\nlocal-hostname: kaiseki-%s\n' "$name" "$(date +%s)" "$name" > "$D/meta-data"
        cloud-localds "$D/seed.iso" "$D/user-data" "$D/meta-data"
    fi
    p=2222; while ss -ltn | grep -q ":$p "; do p=$((p + 1)); done; echo $p > "$D/port"
    qemu-system-x86_64 -name "kaiseki-$name" -machine q35,accel=kvm -cpu host -smp 6 -m 8G \
        -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd -drive if=pflash,format=raw,file="$D/vars.fd" \
        -drive if=none,id=d,format=qcow2,file="$D/disk.qcow2",discard=unmap -device virtio-blk-pci,drive=d \
        -drive if=none,id=s,format=raw,readonly=on,file="$D/seed.iso" -device virtio-blk-pci,drive=s \
        -device virtio-vga-gl -display egl-headless -device qemu-xhci -device usb-tablet -device usb-kbd \
        -nic user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$p-:22 -device virtio-rng-pci \
        -vnc "unix:$D/vnc" -serial "file:$D/serial.log" -qmp unix:"$D/qmp",server,nowait -pidfile "$D/pid" -daemonize
    i=0; until SSH true 2>/dev/null; do i=$((i + 1)); [ $i -gt 90 ] && { echo "ssh did not come up" >&2; exit 1; }; sleep 2; done
    SSH 'cloud-init status --wait >/dev/null 2>&1 || true'
    echo "$name is up: ssh port $p"
    ;;
metal)  # vm metal NAME [ISO KERNEL INITRD "kernel args"]: a bare machine with an empty 64 GB disk, for the installer.
    # With an ISO it boots the ISO's kernel directly (so tests can pass kernel arguments); without, from its disk.
    if [ -f "$D/pid" ] && kill -0 "$(cat "$D/pid")" 2>/dev/null; then echo "$name is already running"; exit 0; fi
    mkdir -p "$D"
    [ -f "$D/disk.qcow2" ] || { qemu-img create -q -f qcow2 "$D/disk.qcow2" 64G; cp /usr/share/OVMF/OVMF_VARS_4M.fd "$D/vars.fd"; }
    p=2222; while ss -ltn | grep -q ":$p "; do p=$((p + 1)); done; echo $p > "$D/port"
    set -- "${1:-}" "${2:-}" "${3:-}" "${4:-}"
    if [ -n "$1" ]; then iso="-drive if=none,id=c,format=raw,readonly=on,file=$1 -device usb-storage,drive=c"; else iso=; fi
    # shellcheck disable=SC2086
    qemu-system-x86_64 -name "kaiseki-$name" -machine q35,accel=kvm -cpu host -smp 6 -m 8G \
        -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd -drive if=pflash,format=raw,file="$D/vars.fd" \
        -drive if=none,id=d,format=qcow2,file="$D/disk.qcow2",discard=unmap -device virtio-blk-pci,drive=d \
        -device virtio-vga-gl -display egl-headless -device qemu-xhci -device usb-tablet -device usb-kbd $iso \
        ${2:+-kernel "$2" -initrd "$3" -append "$4"} \
        -nic user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$p-:22 -device virtio-rng-pci \
        -vnc "unix:$D/vnc" -serial "file:$D/serial.log" -qmp unix:"$D/qmp",server,nowait -pidfile "$D/pid" -daemonize
    echo "$name is up (bare machine${1:+, booting $(basename "$1")}): vm view $name" ;;
ssh) SSH "$@" ;;
push) scp -q -r -i "$KEY" -P "$(port)" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$1" "$U@127.0.0.1:$2" ;;
shot)  # a Wayland session renders on the GPU, which the monitor cannot dump: ask the guest (grim) first
    out=$(realpath "$1")
    if SSH 'export XDG_RUNTIME_DIR=/run/user/$(id -u); export WAYLAND_DISPLAY=$(ls $XDG_RUNTIME_DIR 2>/dev/null | grep -E "^wayland-[0-9]+$" | head -1); [ -n "$WAYLAND_DISPLAY" ] && command -v grim >/dev/null && grim /tmp/kaiseki-shot.png' 2>/dev/null; then
        scp -q -i "$KEY" -P "$(port)" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$U@127.0.0.1:/tmp/kaiseki-shot.png" "$out"
    else "$ROOT/vm/vncshot" "$D/vnc" "$out"; fi ;;   # no ssh or no session: through the console socket
key) qmp key "$@" ;;
type) qmp type "$@" ;;
view)  # watch the console (view-only; "view NAME -i" also sends your keyboard and mouse)
    [ -S "$D/vnc" ] || { echo "$name has no console socket: it was started before vm/vm had one (restart it), or is not running" >&2; exit 1; }
    if [ "${1:-}" = -i ]; then exec xtigervncviewer "$D/vnc"; else exec xtigervncviewer -ViewOnly "$D/vnc"; fi ;;  # for when the guest is unreachable over ssh
down) [ -S "$D/qmp" ] && qmp quit 2>/dev/null || true; rm -f "$D/pid" "$D/qmp" "$D/vnc" ;;
destroy) [ -S "$D/qmp" ] && qmp quit 2>/dev/null || true; rm -rf "$D"; echo "$name destroyed" ;;
list) for d in "$V"/*/; do [ -d "$d" ] || continue; n=$(basename "$d"); if [ -f "$d/pid" ] && kill -0 "$(cat "$d/pid")" 2>/dev/null; then echo "$n running (ssh port $(cat "$d/port"))"; else echo "$n stopped"; fi; done ;;
*) echo "usage: vm up|metal|ssh|push|shot|key|type|view|down|destroy|list [NAME] ..." >&2; exit 2 ;;
esac
