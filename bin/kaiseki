#!/usr/bin/env python3
"""kaiseki - Omarchy's desktop on Debian, kept in step with upstream.

  kaiseki fetch [TAG]     clone/update upstream Omarchy at TAG (default: the tag in ./UPSTREAM)
  kaiseki survey          check every upstream package against the map and real Debian suites;
                          writes docs/SURVEY.md and exits non-zero if a package has no decision
"""
import json, os, subprocess, sys, urllib.request, urllib.parse
ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
UP = os.path.join(ROOT, ".cache", "omarchy")

def sh(*a, **k): return subprocess.run(a, capture_output=True, text=True, **k)

def fetch(tag=None):
    tag = tag or open(os.path.join(ROOT, "UPSTREAM")).read().strip()
    if not os.path.isdir(UP):
        os.makedirs(os.path.dirname(UP), exist_ok=True)
        subprocess.run(["git", "clone", "-q", "--depth", "1", "--branch", tag, "https://github.com/omacom/omarchy.git", UP], check=True)
    else:
        subprocess.run(["git", "-C", UP, "fetch", "-q", "--depth", "1", "origin", "tag", tag], check=True)
        subprocess.run(["git", "-C", UP, "checkout", "-q", tag], check=True)
    print(f"upstream at {tag}: {sh('git', '-C', UP, 'log', '-1', '--format=%h %cd', '--date=short').stdout.strip()}")
    # the recipes (PKGBUILDs) live in a second repository without release tags: pinned by commit in UPSTREAM_PKGS
    pkgs, commit = UP + "-pkgs", open(os.path.join(ROOT, "UPSTREAM_PKGS")).read().strip()
    if not os.path.isdir(pkgs):
        subprocess.run(["git", "clone", "-q", "https://github.com/omacom/omarchy-pkgs.git", pkgs], check=True)
    if sh("git", "-C", pkgs, "cat-file", "-e", commit + "^{commit}").returncode != 0:
        subprocess.run(["git", "-C", pkgs, "fetch", "-q", "--unshallow", "origin"], check=False)
        subprocess.run(["git", "-C", pkgs, "fetch", "-q", "origin"], check=True)
    subprocess.run(["git", "-C", pkgs, "checkout", "-q", commit], check=True)
    pinned = sh("sed", "-n", "s/^_commit='\\(.*\\)'/\\1/p", os.path.join(pkgs, "pkgbuilds/omarchy/PKGBUILD")).stdout.strip()
    head = sh("git", "-C", UP, "rev-parse", "HEAD").stdout.strip()
    print(f"recipes at {commit[:7]}: omarchy recipe pins {pinned[:7]}, " + ("matches the tag" if pinned == head else f"TAG IS {head[:7]}: MISMATCH"))

def load_map():
    m = {}
    for line in open(os.path.join(ROOT, "map", "arch-to-debian.tsv")):
        if line.strip() and not line.startswith("#"):
            f = line.rstrip("\n").split("\t"); m[f[0]] = (f[1] if len(f) > 1 else "=", f[2] if len(f) > 2 else "")
    return m

def upstream_packages():
    out = {}
    for name in ("omarchy-base.packages", "omarchy-other.packages"):
        for line in open(os.path.join(UP, "install", name)):
            p = line.split("#")[0].strip()
            if p: out.setdefault(p, name.split(".")[0].replace("omarchy-", ""))
    return out

def madison(pkgs):
    """Which suites carry each binary package (Debian's archive query service)."""
    res = {}; pkgs = sorted(set(pkgs))
    for i in range(0, len(pkgs), 30):
        url = "https://api.ftp-master.debian.org/madison?f=json&package=" + urllib.parse.quote(" ".join(pkgs[i:i + 30]))
        for entry in json.load(urllib.request.urlopen(url, timeout=90)):
            for pkg, suites in entry.items():
                for suite, vers in suites.items():
                    if any({"amd64", "all"} & set(v.get("architectures", [])) for v in vers.values()):
                        res.setdefault(pkg, {})[suite] = sorted(vers)[-1]
    return res

def survey():
    m = load_map(); ups = upstream_packages(); rows = []; unknown = []
    wanted = set()
    for p in ups:
        tgt = m.get(p, (None, ""))[0]
        if tgt and not tgt.startswith("-"): wanted.update([p] if tgt == "=" else [x.split("|")[0] for x in tgt.split()])
    avail = madison(wanted)
    counts = {"trixie": 0, "backports": 0, "sid-only": 0, "build": 0, "skip": 0, "unmapped": 0, "missing": 0}
    for p, lst in sorted(ups.items()):
        if p not in m: counts["unmapped"] += 1; unknown.append(p); rows.append((p, lst, "?", "UNMAPPED", "")); continue
        tgt, note = m[p]
        if tgt == "-skip": counts["skip"] += 1; rows.append((p, lst, "", "skip", note)); continue
        if tgt == "-build": counts["build"] += 1; rows.append((p, lst, "", "build/vendor", note)); continue
        debs = [p] if tgt == "=" else [x.split("|")[0] for x in tgt.split()]; worst = "trixie"; detail = []
        for d in debs:
            s = avail.get(d, {})
            if "stable" in s: detail.append(f"{d} {s['stable']}")
            elif "stable-backports" in s: detail.append(f"{d} {s['stable-backports']} (backports)"); worst = "backports" if worst == "trixie" else worst
            elif "unstable" in s or "testing" in s: detail.append(f"{d} {s.get('unstable') or s.get('testing')} (unstable only)"); worst = "sid-only" if worst != "missing" else worst
            else: detail.append(f"{d} NOT IN DEBIAN"); worst = "missing"
        counts[worst] += 1; rows.append((p, lst, " ".join(debs), worst, "; ".join(detail) + (f" — {note}" if note else "")))
    tag = open(os.path.join(ROOT, "UPSTREAM")).read().strip()
    with open(os.path.join(ROOT, "docs", "SURVEY.md"), "w") as f:
        f.write(f"# Package survey for Omarchy {tag}\n\nGenerated by `kaiseki survey`. {len(ups)} upstream packages.\n\n")
        f.write("| Status | Count | Meaning |\n|---|---|---|\n")
        for k, meaning in (("trixie", "in Debian 13"), ("backports", "in trixie-backports"), ("sid-only", "only in unstable: needs a local rebuild"),
                           ("build", "built or fetched outside apt"), ("skip", "Arch-only, not needed"), ("missing", "mapped name not found in Debian"), ("unmapped", "no decision yet")):
            f.write(f"| {k} | {counts[k]} | {meaning} |\n")
        f.write("\n| Arch package | List | Debian | Status | Detail |\n|---|---|---|---|---|\n")
        for r in sorted(rows, key=lambda r: (r[3] in ("trixie", "skip"), r[3], r[0])): f.write("| " + " | ".join(r) + " |\n")
    print(" ".join(f"{k}={v}" for k, v in counts.items()))
    for r in rows:
        if r[3] in ("sid-only", "missing", "UNMAPPED"): print(f"  {r[3]:<9} {r[0]:<34} {r[4][:90]}")
    return 1 if counts["unmapped"] or counts["missing"] else 0

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "fetch": fetch(*sys.argv[2:3])
    elif cmd == "survey": sys.exit(survey())
    else: print(__doc__); sys.exit(2)
