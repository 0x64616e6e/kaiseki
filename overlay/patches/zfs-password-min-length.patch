Description: kaiseki encrypts the disk with ZFS, which refuses passphrases under 8 characters. Upstream (LUKS)
 accepts any non-empty password, so a short one passed the form and only failed later, at the re-key step.
 Ask for 8 characters up front, before the confirmation prompt.

--- a/install/provisioning/setup-form.sh	2026-10-06 22:32:48.960375501 +0300
+++ b/install/provisioning/setup-form.sh	2026-10-06 22:32:48.976375512 +0300
@@ -124,8 +124,12 @@
 omarchy_prompt_password() {
   local status
   while true; do
-    password=$(gum input --placeholder "Used for user + root, and disk encryption when enabled" --prompt.foreground="#845DF9" --password --prompt "Password> ") && status=0 || status=$?
+    password=$(gum input --placeholder "8 characters or more: for user + root and disk encryption" --prompt.foreground="#845DF9" --password --prompt "Password> ") && status=0 || status=$?
     ((status == 0)) || return $status
+    if ((${#password} < 8)); then
+      notice "Password must be at least 8 characters (disk encryption requires it)" 2
+      continue
+    fi
     password_confirmation=$(gum input --placeholder "Must match the password you just typed" --prompt.foreground="#845DF9" --password --prompt "Confirm> ") && status=0 || status=$?
     ((status == 0)) || return $status
 
