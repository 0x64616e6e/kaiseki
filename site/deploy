#!/bin/bash
# site/deploy   (on the host)   Publish the landing page: site/index.html and a few screenshots from docs/img.
set -euo pipefail
T=$(cd "$(dirname "$0")/.." && pwd); . "$T/packages/repo.conf"; S=$T/.cache/site; D=$T/docs/img
rm -rf "$S"; mkdir -p "$S/img"; cp "$T/site/index.html" "$T/site/error.html" "$S/"
# the download section names the ISO that installer/publish-iso last uploaded
P=$T/.cache/iso-publish; name=$(cat "$P/latest.txt"); iso=$T/.cache/iso/kaiseki-$(cat "$T/UPSTREAM").iso
sed -i -e "s/@@ISO_NAME@@/$name/g" -e "s/@@ISO_SHA@@/$(cut -d' ' -f1 "$P/$name.sha256")/g" \
       -e "s/@@ISO_SIZE@@/$(numfmt --to=si --round=nearest --format='%.1f' "$(stat -c %s "$iso")")B/g" \
       -e "s/@@ISO_DATE@@/$(date -u -r "$iso" +%Y-%m-%d)/g" -e "s/@@UPSTREAM@@/$(cat "$T/UPSTREAM")/g" "$S/index.html"
! grep -q '@@' "$S/index.html" || { echo "unfilled placeholder in the page"; exit 1; }
cp "$D/installer/0-iso-menu.png" "$S/img/iso-menu.png"; cp "$D/installer/3-first-boot.png" "$S/img/first-boot.png"
# console screens: show the part with the text, larger, so it can be read in a thumbnail
convert "$D/installer/1-choose-disk.png" -crop 880x550+200+0 +repage "$S/img/choose-disk-text.png"   # centred under the wordmark
convert "$D/installer/5-confirm.png" -crop 800x500+230+0 +repage "$S/img/confirm-text.png"
cp "$D/installer/8-cold-boot-passphrase.png" "$S/img/unlock.png"; cp "$D/desktop.png" "$D/apps.png" "$S/img/"
convert "$D/installer/7-desktop.png" -quality 86 "$S/img/desktop-wall.jpg"     # the wallpaper is 1.6 MB as PNG
# the link-preview card (1200x630): the desktop screenshot, cropped to the card's shape
convert "$D/desktop.png" -resize 1200x -gravity north -crop 1200x630+0+0 +repage "$S/img/card.png"
# the screencast (tests/screencast makes it; not kept in git) and a frame of it as the poster
cast=$T/.cache/screencast/cast.mp4
if [ -f "$cast" ]; then
    mkdir -p "$S/video"; cp "$cast" "$S/video/kaiseki-install-update.mp4"
    ffmpeg -loglevel error -y -ss 216 -i "$cast" -frames:v 1 -q:v 3 "$S/img/screencast-poster.jpg"
fi
# Cloudflare keeps images and the video for four hours by path: give each deploy's files a new address
v=$(date -u +%Y%m%d%H%M); sed -i -E "s#(/site/(img|video)/[A-Za-z0-9._-]+)([\"')])#\\1?v=$v\\3#g" "$S/index.html"
rsync -a --delete "$S/" "$KAISEKI_REPO_HOST:$(dirname "$KAISEKI_REPO_PATH")/site/"
echo "deployed: $(du -sh "$S" | cut -f1) to $KAISEKI_REPO_HOST:$(dirname "$KAISEKI_REPO_PATH")/site/"
